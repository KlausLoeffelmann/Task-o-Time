<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(ValidationFramework)' == ''">net472</TargetFramework>
    <TargetFramework Condition="'$(ValidationFramework)' != ''">$(ValidationFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <LangVersion>10</LangVersion>
    <ApplicationRoot Condition="'$(ApplicationRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\src\TaskOTime</ApplicationRoot>
    <ViewModelProject Condition="Exists('$(ApplicationRoot)\TaskOTime.ViewModel\TaskOTime.ViewModel.csproj')">$(ApplicationRoot)\TaskOTime.ViewModel\TaskOTime.ViewModel.csproj</ViewModelProject>
    <ViewModelProject Condition="'$(ViewModelProject)' == ''">$(ApplicationRoot)\TaskOTime.ViewModel\TaskOTime.ViewModel.vbproj</ViewModelProject>
  </PropertyGroup>
  <Import Project="..\FixtureRunner\ValidationDataApi.props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.8.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.8.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net472'" />
    <ProjectReference Include="$(ViewModelProject)" />
    <ProjectReference Include="$(ApplicationRoot)\TaskOTime.TimeTrackingServices.Tests\TestDoubles\TaskOTime.TimeTrackingServices.TestDoubles.csproj" />
  </ItemGroup>
</Project>
