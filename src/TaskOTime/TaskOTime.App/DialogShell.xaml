<Window x:Class="TaskOTime.App.DialogShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        MinWidth="460"
        MaxWidth="620"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Border Style="{StaticResource PanelBorderStyle}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       Text="{Binding Heading}" />
            <TextBlock Grid.Row="1"
                       Foreground="{StaticResource ContentForegroundBrush}"
                       Background="{StaticResource ContentBackgroundBrush}"
                       Padding="8"
                       TextWrapping="Wrap"
                       Text="{Binding LeadText}" />

            <ItemsControl Grid.Row="2"
                          Margin="0,12,0,16"
                          ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="Bold"
                                       Margin="0,0,8,0"
                                       Text="•" />
                            <TextBlock Foreground="{StaticResource MutedForegroundBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Row="3"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    Command="{Binding CloseCommand}"
                    Content="{StaticResource DialogCloseButtonText}"
                    IsDefault="True" />
        </Grid>
    </Border>
</Window>
