<Window x:Class="TaskOTime.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task-o-Time – Anmeldung" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Anmeldung" Style="{StaticResource SectionHeaderTextStyle}"/>
        <TextBlock x:Name="ModeText" TextWrapping="Wrap" Foreground="{StaticResource MutedForegroundBrush}" Margin="0,8"/>
        <TextBlock Text="Benutzer oder E-Mail" Foreground="{StaticResource MutedForegroundBrush}"/>
        <TextBox x:Name="UserName" Margin="0,4,0,10"/>
        <TextBlock Text="Kennwort" Foreground="{StaticResource MutedForegroundBrush}"/>
        <PasswordBox x:Name="Password" Margin="0,4,0,10"/>
        <TextBlock Text="Neues Kennwort (nur bei vorläufigem Kennwort)" Foreground="{StaticResource MutedForegroundBrush}"/>
        <PasswordBox x:Name="NewPassword" Margin="0,4,0,10"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Salmon" TextWrapping="Wrap" Margin="0,4,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anmelden" IsDefault="True" Click="OnLogin" MinWidth="100"/>
            <Button Content="Abbrechen" IsCancel="True" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
