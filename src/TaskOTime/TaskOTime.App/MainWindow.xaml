<Window x:Class="TaskOTime.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:convert="clr-namespace:TaskOTime.App.Convert"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:TaskOTime.ViewModel.ViewModels;assembly=TaskOTime.ViewModel"
        mc:Ignorable="d"
        xmlns:loc="clr-namespace:TaskOTime.ViewModel.Localization;assembly=TaskOTime.ViewModel"
        Language="{loc:Culture}"
        Title="{loc:Loc AppTitle}"
        MinHeight="640"
        MinWidth="820"
        Height="760"
        Width="1120"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ContentForegroundBrush}">
    <Window.Resources>
        <convert:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <convert:BooleanToGridLengthConverter x:Key="TaskPanelColumnWidthConverter"
                                              TrueLength="320"
                                              FalseLength="0" />
        <convert:BooleanToGridLengthConverter x:Key="TaskPanelSplitterWidthConverter"
                                              TrueLength="8"
                                              FalseLength="0" />
        <convert:BooleanToGridLengthConverter x:Key="NarrowTaskPanelRowHeightConverter"
                                              TrueLength="0"
                                              FalseLength="Auto" />
        <convert:TimeSpanDisplayConverter x:Key="TimeSpanDisplayConverter" />
        <CollectionViewSource x:Key="BookedDatesView" Source="{Binding BookedDates}">
            <CollectionViewSource.GroupDescriptions>
                <data:PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style TargetType="{x:Type Menu}">
            <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MenuForegroundBrush}" />
        </Style>

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource MenuPopupBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <Border x:Name="MenuItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource MenuPopupBackgroundBrush}"
                                        BorderBrush="{DynamicResource MenuPopupBackgroundBrush}"
                                        BorderThickness="0"
                                        Padding="4">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource HoverForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource HoverForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource ListItemBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource HoverForegroundBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ListItemSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource MenuForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandStripIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource CommandBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CommandBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MenuForegroundBrush}" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource HoverForegroundBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ListItemSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ContentTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ListItemForegroundBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="PlaceholderItemTemplate">
            <Border Background="{DynamicResource ContentBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,0,6"
                    Padding="8">
                <TextBlock Style="{StaticResource ContentTextStyle}" Text="{Binding}" />
            </Border>
        </DataTemplate>

        <Style x:Key="TaskCardMutedTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource ListItemForegroundBrush}" />
            <Setter Property="Opacity" Value="0.82" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TaskPanelListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="SelectionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="{DynamicResource ListItemSelectedBackgroundBrush}" />
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource ListItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ContentForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskPanelListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TaskPanelListBoxItemStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <DataTemplate x:Key="TaskListTemplate" DataType="{x:Type vm:TaskListViewModel}">
            <Border Background="{DynamicResource ListItemBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="5"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc NewTaskListButtonText}"
                                  Command="{Binding PlacementTarget.Tag.NewTaskListCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="{loc:Loc EditTaskListButtonText}"
                                  Command="{Binding PlacementTarget.Tag.EditTaskListCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource ContentTextStyle}"
                               FontWeight="SemiBold"
                               Text="{Binding Title}" />
                    <DockPanel Grid.Row="1" Margin="0,3,0,0">
                        <TextBlock DockPanel.Dock="Right"
                                   Style="{StaticResource TaskCardMutedTextStyle}"
                                   Text="{Binding ProgressSummary}" />
                        <TextBlock Style="{StaticResource TaskCardMutedTextStyle}"
                                   Text="{Binding Subtitle}" />
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TaskItemTemplate" DataType="{x:Type vm:TaskItemViewModel}">
            <Border Background="{DynamicResource ListItemBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="5"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc NewTaskButtonText}"
                                  Command="{Binding PlacementTarget.Tag.NewTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="{loc:Loc EditTaskButtonText}"
                                  Command="{Binding PlacementTarget.Tag.EditTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="{loc:Loc StartTaskButtonText}"
                                  Command="{Binding PlacementTarget.Tag.StartTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="{loc:Loc CompleteTaskButtonText}"
                                  Command="{Binding PlacementTarget.Tag.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                        <MenuItem Header="{loc:Loc Main_More}"
                                  Command="{Binding PlacementTarget.Tag.MoreToDoCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock x:Name="RecordingGlyph"
                                   DockPanel.Dock="Left"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Margin="0,0,6,0"
                                   Text=""
                                   Foreground="{DynamicResource RecordingForegroundBrush}"
                                   Visibility="{Binding IsStarted, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStarted}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="RecordingPulseStoryboard">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                        From="1"
                                                                        To="0.7"
                                                                        Duration="0:0:0.85" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="RecordingPulseStoryboard" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource ContentTextStyle}" TargetType="{x:Type TextBlock}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                        <Setter Property="Opacity" Value="0.62" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Grid.Row="1"
                               Margin="0,3,0,0"
                               Style="{StaticResource TaskCardMutedTextStyle}"
                               Text="{Binding Description}" />
                    <DockPanel Grid.Row="2" Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding StatusText}" />
                        <TextBlock Style="{StaticResource TaskCardMutedTextStyle}"
                                   Text="{Binding DueText}" />
                    </DockPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BookedDateTemplate">
            <TextBlock Foreground="{DynamicResource ListItemForegroundBrush}"
                       Margin="0,0,0,4"
                       FontWeight="SemiBold"
                       Text="{Binding DisplayText}" />
        </DataTemplate>

        <Style x:Key="TimeEntryListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="SelectionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="{DynamicResource ListItemSelectedBackgroundBrush}" />
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource ListItemSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ContentForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeEntryListBoxStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TimeEntryListBoxItemStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <DataTemplate x:Key="TimeEntryItemTemplate" DataType="{x:Type vm:TimeEntryViewModel}">
            <Border Background="{DynamicResource ListItemBackgroundBrush}"
                    BorderBrush="{Binding MarkerAccent}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Foreground="{DynamicResource ListItemForegroundBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding EntryTimeText}" />
                        <TextBlock Foreground="{Binding MarkerAccent}"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   Text="{Binding MarkerVisualHint}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{Binding MarkerAccent}"
                            Margin="0,2,8,2" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Foreground="{DynamicResource ListItemForegroundBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding Title}" />
                        <TextBlock Foreground="{DynamicResource ListItemForegroundBrush}"
                                   Margin="0,2,0,4"
                                   Text="{Binding Description}" />
                        <TextBlock Foreground="{Binding MarkerAccent}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding MarkerLabel}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                        <TextBlock Foreground="{DynamicResource ListItemForegroundBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Text="{Binding DurationToNextText}" />
                        <TextBlock Foreground="{DynamicResource ListItemForegroundBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   Text="{loc:Loc Main_UntilNext}" />
                        <TextBlock Foreground="{DynamicResource ListItemForegroundBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   Margin="0,6,0,0"
                                   Text="{loc:Loc Main_SincePrevious}" />
                        <TextBlock Foreground="{DynamicResource ListItemForegroundBrush}"
                                   FontSize="11"
                                   HorizontalAlignment="Right"
                                   Text="{Binding DurationFromPreviousText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TaskPanelTemplate" DataType="{x:Type vm:TaskManagementViewModel}">
            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               Text="{Binding TaskPanelTitle}" />
                    <TextBlock Grid.Row="1"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,10"
                               Text="{Binding TaskPanelSummary}" />

                    <TextBlock Grid.Row="2"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               Text="{loc:Loc Main_Lists}" />
                    <ListBox Grid.Row="3"
                             MaxHeight="170"
                             ItemTemplate="{StaticResource TaskListTemplate}"
                             ItemsSource="{Binding TaskLists}"
                             MouseDoubleClick="OnTaskListDoubleClick"
                             SelectedItem="{Binding SelectedTaskList, Mode=TwoWay}"
                             Style="{StaticResource TaskPanelListBoxStyle}" />

                    <DockPanel Grid.Row="4" Margin="0,8,0,6">
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   Text="{Binding SelectedListSummary}" />
                        <TextBlock Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Text="{loc:Loc Main_Tasks}" />
                    </DockPanel>

                    <CheckBox Grid.Row="5"
                              Foreground="{DynamicResource MutedForegroundBrush}"
                              Margin="0,0,0,6"
                              Content="{loc:Loc CompleteRecordingTaskCheckBoxText}"
                              IsChecked="{Binding CompleteRecordingOnNextTimeEntry}" />

                    <ListBox Grid.Row="6"
                             ItemTemplate="{StaticResource TaskItemTemplate}"
                             ItemsSource="{Binding SelectedTaskList.Tasks}"
                             SelectedItem="{Binding SelectedTaskItem, Mode=TwoWay}"
                             Style="{StaticResource TaskPanelListBoxStyle}" />

                    <TextBlock Grid.Row="7"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,8,0,0"
                               Text="{Binding SelectedTaskSummary}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="{loc:Loc FileMenuHeader}">
                <MenuItem Header="{loc:Loc ExportDayMenuHeader}"
                          Command="{Binding ExportSelectedDayCommand}" />
                <MenuItem Header="{loc:Loc ExportPeriodMenuHeader}"
                          Command="{Binding ExportPeriodCommand}" />
                <MenuItem Header="{loc:Loc Main_Logout}" Click="OnLogoutClick" />
                <MenuItem Header="{loc:Loc QuitMenuHeader}" Click="OnQuitMenuItemClick" />
            </MenuItem>
            <MenuItem Header="{loc:Loc MainDataMenuHeader}">
                <MenuItem Header="{loc:Loc ManageProjectsMenuHeader}"
                          Command="{Binding ManageProjectsCommand}" />
                <MenuItem Header="{loc:Loc NewTaskListButtonText}"
                          Command="{Binding TaskManagement.NewTaskListCommand}" />
                <MenuItem Header="{loc:Loc ManageTaskListsMenuHeader}"
                          Command="{Binding ManageTaskListsCommand}" />
                <MenuItem Header="{loc:Loc ManageTasksMenuHeader}"
                          Command="{Binding ManageTasksCommand}" />
                <MenuItem Header="{loc:Loc ManageUsersAdminMenuHeader}"
                          Command="{Binding ManageUsersAdminCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc AnalysisMenuHeader}">
                <MenuItem Header="{loc:Loc DailyStatementMenuHeader}"
                          Command="{Binding ShowDailyStatementCommand}" />
                <MenuItem Header="{loc:Loc WeeklyStatementMenuHeader}"
                          Command="{Binding ShowWeeklyStatementCommand}" />
                <MenuItem Header="{loc:Loc MonthlyStatementMenuHeader}"
                          Command="{Binding ShowMonthlyStatementCommand}" />
                <MenuItem Header="{loc:Loc TenantAdminStatisticsMenuHeader}"
                          Command="{Binding ShowTenantAdminStatisticsCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc ToolsMenuHeader}">
                <MenuItem Header="{loc:Loc OptionsMenuHeader}"
                          Command="{Binding OptionsCommand}" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="{DynamicResource CommandBackgroundBrush}" Padding="8,3">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Command="{Binding TaskManagement.NewTaskCommand}" Style="{StaticResource CommandStripIconButtonStyle}" ToolTip="{loc:Loc NewTaskButtonText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                </Button>
                <Button Command="{Binding TaskManagement.EditTaskCommand}" Style="{StaticResource CommandStripIconButtonStyle}" ToolTip="{loc:Loc EditTaskButtonText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                </Button>
                <Button Command="{Binding TaskManagement.NewTaskListCommand}" Style="{StaticResource CommandStripIconButtonStyle}" ToolTip="{loc:Loc NewTaskListButtonText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                </Button>
                <Button Command="{Binding TaskManagement.EditTaskListCommand}" Style="{StaticResource CommandStripIconButtonStyle}" ToolTip="{loc:Loc EditTaskListButtonText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                </Button>
                <Button Command="{Binding TaskManagement.StartTaskCommand}" Style="{StaticResource CommandStripIconButtonStyle}" ToolTip="{loc:Loc StartTaskButtonText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                </Button>
                <Button x:Name="CommandStripCheckOutButton"
                        Click="OnCommandStripCheckOutClick"
                        Style="{StaticResource CommandStripIconButtonStyle}"
                        ToolTip="{loc:Loc CheckOutButtonText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                </Button>
                <StackPanel Orientation="Horizontal"
                            Margin="2,0,4,0"
                            Visibility="{Binding IsTaskRecording, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource MenuForegroundBrush}"
                               Margin="0,0,4,0"
                               Text="{loc:Loc Main_Start}" />
                    <TextBox MinWidth="72"
                             Width="72"
                             Margin="0,0,4,0"
                             Text="{Binding ManualCompletionStartText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource MenuForegroundBrush}"
                               Margin="0,0,4,0"
                               Text="{loc:Loc Main_Duration}" />
                    <TextBox MinWidth="72"
                             Width="72"
                             Margin="0,0,4,0"
                             Text="{Binding ManualCompletionDurationText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Command="{Binding TaskManagement.CompleteTaskCommand}" Style="{StaticResource CommandStripIconButtonStyle}" ToolTip="{loc:Loc CompleteTaskButtonText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                </Button>
                <Button x:Name="CommandStripWorkBreakButton"
                        Click="OnCommandStripWorkBreakClick"
                        Style="{StaticResource CommandStripIconButtonStyle}"
                        ToolTip="{loc:Loc PauseButtonText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                </Button>
                <Button x:Name="CommandStripDownTimeButton"
                        Click="OnCommandStripDownTimeClick"
                        Style="{StaticResource CommandStripIconButtonStyle}"
                        ToolTip="{loc:Loc DownTimeButtonText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                </Button>
                <Button x:Name="CommandStripErrandButton"
                        Click="OnCommandStripErrandClick"
                        Style="{StaticResource CommandStripIconButtonStyle}"
                        ToolTip="{loc:Loc ErrandButtonText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsTaskRecording, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="" Foreground="{DynamicResource RecordingForegroundBrush}">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                        From="1"
                                                        To="0.7"
                                                        Duration="0:0:0.85" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource MenuForegroundBrush}" Text="{Binding RecordingStatusText}" />
                </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               Text="{loc:Loc Main_Date}" />

                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,10"
                                Orientation="Horizontal">
                        <Button Command="{Binding TodayCommand}"
                                ToolTip="{loc:Loc TodayButtonText}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                        </Button>
                        <Button Command="{Binding YesterdayCommand}"
                                Margin="0"
                                ToolTip="{loc:Loc YesterdayButtonText}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                        </Button>
                    </StackPanel>

                    <Calendar Grid.Row="2"
                             Style="{DynamicResource ThemedCalendarStyle}"
                              Margin="0,0,0,12"
                             SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    </Calendar>

                    <StackPanel Grid.Row="3">
                       <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                                  Text="{loc:Loc BookedDaysHeader}" />
                       <ListBox Background="{DynamicResource ListItemBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                Foreground="{DynamicResource ListItemForegroundBrush}"
                                ItemTemplate="{StaticResource BookedDateTemplate}"
                                ItemsSource="{Binding Source={StaticResource BookedDatesView}}"
                                SelectedValue="{Binding SelectedDate, Mode=TwoWay}"
                                SelectedValuePath="BookingDate">
                           <ListBox.GroupStyle>
                               <GroupStyle>
                                   <GroupStyle.HeaderTemplate>
                                       <DataTemplate>
                                           <Border Background="{DynamicResource PanelBackgroundBrush}" Padding="4,3">
                                               <TextBlock Foreground="{DynamicResource AccentBrush}"
                                                          FontWeight="SemiBold"
                                                          Text="{Binding Name}" />
                                           </Border>
                                       </DataTemplate>
                                   </GroupStyle.HeaderTemplate>
                               </GroupStyle>
                           </ListBox.GroupStyle>
                       </ListBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="{Binding IsWideLayout, Converter={StaticResource NarrowTaskPanelRowHeightConverter}}" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding IsWideLayout, Converter={StaticResource TaskPanelSplitterWidthConverter}}" />
                    <ColumnDefinition Width="{Binding IsWideLayout, Converter={StaticResource TaskPanelColumnWidthConverter}}" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   Text="{Binding CenterPanelTitle}" />
                        <TextBlock Grid.Row="1"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"
                                   Text="{Binding SelectedDateSummary}" />
                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,0,0,12"
                                   Text="{Binding CenterPanelSummary}" />

                        <WrapPanel Grid.Row="3" Margin="0,0,0,10">
                            <Button Command="{Binding TimeCollection.AddCommand}"
                                    ToolTip="{loc:Loc AddTimeEntryButtonText}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                            </Button>
                            <Button Command="{Binding TimeCollection.EditCommand}"
                                    ToolTip="{loc:Loc EditTimeEntryButtonText}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                            </Button>
                            <Button Command="{Binding TimeCollection.DeleteCommand}"
                                    ToolTip="{loc:Loc DeleteTimeEntryButtonText}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                            </Button>
                            <Button Command="{Binding TimeCollection.InsertWorkBreakCommand}"
                                    ToolTip="{loc:Loc InsertWorkBreakButtonText}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                            </Button>
                            <Button Command="{Binding TimeCollection.InsertDownTimeCommand}"
                                    ToolTip="{loc:Loc InsertDownTimeButtonText}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                            </Button>
                            <Button Command="{Binding TimeCollection.InsertErrandCommand}"
                                    ToolTip="{loc:Loc InsertErrandButtonText}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                            </Button>
                            <Button Command="{Binding TimeCollection.InsertStopMarkCommand}"
                                    Margin="0"
                                    ToolTip="{loc:Loc InsertStopMarkButtonText}">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="" />
                            </Button>
                        </WrapPanel>

                        <ListView Grid.Row="4"
                                 ItemTemplate="{StaticResource TimeEntryItemTemplate}"
                                 ItemsSource="{Binding TimeCollection.TimeItems}"
                                 MouseDoubleClick="OnTimeEntryDoubleClick"
                                 SelectedItem="{Binding TimeCollection.SelectedEntry, Mode=TwoWay}"
                                 Style="{StaticResource TimeEntryListBoxStyle}" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="0"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource PanelBorderBrush}"
                              Visibility="{Binding IsWideLayout, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ContentControl Grid.Row="0"
                                Grid.Column="2"
                                Content="{Binding TaskManagement}"
                                ContentTemplate="{StaticResource TaskPanelTemplate}"
                                Visibility="{Binding IsWideLayout, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ContentControl Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Content="{Binding TaskManagement}"
                                ContentTemplate="{StaticResource TaskPanelTemplate}"
                                Visibility="{Binding IsWideLayout, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedDateSummary}" />
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Main_Target}" />
                    <TextBlock Text="{Binding TargetTime, Converter={StaticResource TimeSpanDisplayConverter}}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Main_Booked}" />
                    <TextBlock Text="{Binding BookedTime, Converter={StaticResource TimeSpanDisplayConverter}}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Main_Open}" />
                    <TextBlock Text="{Binding RemainingTime, Converter={StaticResource TimeSpanDisplayConverter}}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
