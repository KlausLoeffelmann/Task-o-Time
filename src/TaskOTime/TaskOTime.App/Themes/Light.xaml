<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#FFF2F4F7</Color>
    <Color x:Key="PanelBackgroundColor">#FFE8EDF2</Color>
    <Color x:Key="PanelBorderColor">#FF667788</Color>
    <Color x:Key="ContentBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ListItemBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ListItemSelectedBackgroundColor">#FF185A91</Color>
    <Color x:Key="ListItemSelectedBorderColor">#FF123D60</Color>
    <Color x:Key="ContentForegroundColor">#FF1F2933</Color>
    <Color x:Key="ListItemForegroundColor">#FF1F2933</Color>
    <Color x:Key="MutedForegroundColor">#FF4A5765</Color>
    <Color x:Key="MenuForegroundColor">#FF1F2933</Color>
    <Color x:Key="MenuPopupBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="CommandBackgroundColor">#FFE8EDF2</Color>
    <Color x:Key="AccentColor">#FF185A91</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{DynamicResource PanelBorderColor}" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{DynamicResource ContentBackgroundColor}" />
    <SolidColorBrush x:Key="ListItemBackgroundBrush" Color="{DynamicResource ListItemBackgroundColor}" />
    <SolidColorBrush x:Key="ListItemSelectedBackgroundBrush" Color="{DynamicResource ListItemSelectedBackgroundColor}" />
    <SolidColorBrush x:Key="ListItemSelectedBorderBrush" Color="{DynamicResource ListItemSelectedBorderColor}" />
    <SolidColorBrush x:Key="ContentForegroundBrush" Color="{DynamicResource ContentForegroundColor}" />
    <SolidColorBrush x:Key="ListItemForegroundBrush" Color="{DynamicResource ListItemForegroundColor}" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="{DynamicResource MutedForegroundColor}" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="{DynamicResource MenuForegroundColor}" />
    <SolidColorBrush x:Key="MenuPopupBackgroundBrush" Color="{DynamicResource MenuPopupBackgroundColor}" />
    <SolidColorBrush x:Key="CommandBackgroundBrush" Color="{DynamicResource CommandBackgroundColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#FFD1E5F5" />
    <SolidColorBrush x:Key="HoverForegroundBrush" Color="#FF142D40" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#FFE2E7EC" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#FF4A5765" />
    <SolidColorBrush x:Key="FocusBrush" Color="#FF7736AA" />
</ResourceDictionary>
