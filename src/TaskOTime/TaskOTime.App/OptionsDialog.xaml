<Window x:Class="TaskOTime.App.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TaskOTime.ViewModel.Localization;assembly=TaskOTime.ViewModel"
        Language="{loc:Culture}"
        Title="{loc:Loc Options_Title}"
        MinWidth="520"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Border Style="{StaticResource PanelBorderStyle}" Margin="12">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{loc:Loc Options_Title}" />
            <TextBlock Text="{loc:Loc Options_Language}" />
            <ComboBox Margin="0,4,0,12" ItemsSource="{Binding AvailableCultures}"
                      DisplayMemberPath="NativeName" SelectedValuePath="Name"
                      SelectedValue="{Binding CultureName}" />
            <CheckBox Margin="0,4,0,10"
                      Foreground="{StaticResource MutedForegroundBrush}"
                      Content="{loc:Loc Options_RestorePlacement}"
                      IsChecked="{Binding RestoreMainWindowPlacement}" />

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{loc:Loc Options_Workdays}" />
            <CheckBox Margin="0,0,0,4"
                      Foreground="{StaticResource MutedForegroundBrush}"
                      Content="{loc:Loc Options_Saturday}"
                      IsChecked="{Binding SaturdayIsWorkday}" />
            <CheckBox Margin="0,0,0,12"
                      Foreground="{StaticResource MutedForegroundBrush}"
                      Content="{loc:Loc Options_Sunday}"
                      IsChecked="{Binding SundayIsWorkday}" />

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{loc:Loc BookedDaysHeader}" />
            <DockPanel Margin="0,0,0,4">
                <ComboBox Width="110"
                          DockPanel.Dock="Right"
                          ItemsSource="{Binding RangeUnitChoices}"
                          DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectedValue="{Binding BookedDateRangeUnit}" />
                <TextBox Width="64"
                         Margin="0,0,8,0"
                         Text="{Binding BookedDateRangeCount, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Foreground="{StaticResource MutedForegroundBrush}"
                       Margin="0,0,0,16"
                       Text="{Binding BookedDateRangeDescription}" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="42" ToolTip="{loc:Loc Common_OK}" IsDefault="True" Click="OnOkClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource MenuForegroundBrush}" Text="" />
                </Button>
                <Button MinWidth="42" ToolTip="{loc:Loc Common_Cancel}" IsCancel="True">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource MenuForegroundBrush}" Text="" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
