<Window x:Class="TaskOTime.App.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optionen"
        MinWidth="520"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Border Style="{StaticResource PanelBorderStyle}" Margin="12">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Optionen" />
            <CheckBox Margin="0,4,0,10"
                      Foreground="{StaticResource MutedForegroundBrush}"
                      Content="Hauptfenster-Position und -Ausmasse beim Beenden sichern und beim Start wiederherstellen."
                      IsChecked="{Binding RestoreMainWindowPlacement}" />

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Arbeitstage" />
            <CheckBox Margin="0,0,0,4"
                      Foreground="{StaticResource MutedForegroundBrush}"
                      Content="Samstag ist Arbeitstag"
                      IsChecked="{Binding SaturdayIsWorkday}" />
            <CheckBox Margin="0,0,0,12"
                      Foreground="{StaticResource MutedForegroundBrush}"
                      Content="Sonntag ist Arbeitstag"
                      IsChecked="{Binding SundayIsWorkday}" />

            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Tage mit Buchungen" />
            <DockPanel Margin="0,0,0,4">
                <ComboBox Width="110"
                          DockPanel.Dock="Right"
                          ItemsSource="{Binding AvailableRangeUnits}"
                          SelectedItem="{Binding BookedDateRangeUnit}" />
                <TextBox Width="64"
                         Margin="0,0,8,0"
                         Text="{Binding BookedDateRangeCount, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Foreground="{StaticResource MutedForegroundBrush}"
                       Margin="0,0,0,16"
                       Text="{Binding BookedDateRangeDescription}" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="42" ToolTip="OK" IsDefault="True" Click="OnOkClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource MenuForegroundBrush}" Text="" />
                </Button>
                <Button MinWidth="42" ToolTip="Abbrechen" IsCancel="True">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource MenuForegroundBrush}" Text="" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
