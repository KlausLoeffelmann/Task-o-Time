<?xml version="1.0" encoding="utf-8"?><UserControl x:Class="TaskOTime.ViewModel.Views.CollaborationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource MainDataViewStyle}">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
  <TextBlock x:Name="HeadingLabel" x:FieldModifier="public" Text="Kategorien, Tags, Notizen, Weblinks und Aktivität" Style="{DynamicResource MainDataHeadingTextStyle}" />
  <TabControl Grid.Row="1" x:Name="DetailTabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" x:FieldModifier="public" Style="{DynamicResource MainDataTabControlStyle}">
   <TabItem Header="Kategorien"><ListView x:Name="CategoryListView" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" x:FieldModifier="public" Style="{DynamicResource MainDataListViewStyle}"><ListView.View><GridView ColumnHeaderContainerStyle="{DynamicResource MainDataGridViewColumnHeaderStyle}"><GridViewColumn Header="Kategorie" DisplayMemberBinding="{Binding CategoryName}" Width="210" /><GridViewColumn Header="Beschreibung" DisplayMemberBinding="{Binding CategoryDescription}" Width="440" /></GridView></ListView.View></ListView></TabItem>
   <TabItem Header="Tags"><ListBox x:Name="TagListBox" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}" x:FieldModifier="public" DisplayMemberPath="Tag" Style="{DynamicResource MainDataListBoxStyle}" /></TabItem>
   <TabItem Header="Notizen"><ListView x:Name="NoteListView" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote, Mode=TwoWay}" x:FieldModifier="public" DisplayMemberPath="NoteText" Style="{DynamicResource MainDataListViewStyle}" /></TabItem>
   <TabItem Header="Weblinks"><ListView x:Name="WebLinkListView" ItemsSource="{Binding WebLinks}" SelectedItem="{Binding SelectedWebLink, Mode=TwoWay}" x:FieldModifier="public" DisplayMemberPath="Title" Style="{DynamicResource MainDataListViewStyle}" /></TabItem>
   <TabItem Header="Aktivität"><ListView x:Name="LogListView" ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog, Mode=TwoWay}" x:FieldModifier="public" Style="{DynamicResource MainDataListViewStyle}"></ListView></TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
   <TextBox x:Name="QuickValueTextBox" Text="{Binding QuickValue, UpdateSourceTrigger=PropertyChanged}" x:FieldModifier="public" Width="280" Margin="3" Style="{DynamicResource MainDataTextBoxStyle}" />
   <Button x:Name="AddButton" Command="{Binding AddCommand}" x:FieldModifier="public" Content="Hinzufügen" Width="95" Margin="3" Style="{DynamicResource MainDataButtonStyle}" />
   <Button x:Name="DeleteButton" Command="{Binding DeleteCommand}" x:FieldModifier="public" Content="Entfernen" Width="95" Margin="3" Style="{DynamicResource MainDataButtonStyle}" />
  </StackPanel>
 </Grid>
</UserControl>
