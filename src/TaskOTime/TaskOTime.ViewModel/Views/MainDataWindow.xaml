<?xml version="1.0" encoding="utf-8"?><Window x:Class="TaskOTime.ViewModel.Views.MainDataWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TaskOTime.ViewModel.Views" Title="Task-o-Time Verwaltungsarbeitsplatz" Height="760" Width="1180" Style="{DynamicResource MainDataWindowStyle}">
    <Grid Margin="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="31" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="3" Padding="13,5">
            <DockPanel>
                <TextBlock x:Name="TitleLabel" x:FieldModifier="public" Text="Task-o-Time" Style="{DynamicResource MainDataHeadingTextStyle}" VerticalAlignment="Center" />
                <Button x:Name="AboutButton" Command="{Binding AboutCommand}" x:FieldModifier="public" Content="Info" Width="82" Height="27" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{DynamicResource MainDataButtonStyle}" />
            </DockPanel>
        </Border>
        <TabControl x:Name="WorkspaceTabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" x:FieldModifier="public" Grid.Row="1" Margin="0,9,0,4" Style="{DynamicResource MainDataTabControlStyle}">
            <TabItem Header="Mandanten / Benutzer"><local:TenantUserView x:Name="TenantUserScreen" DataContext="{Binding TenantUsers}" x:FieldModifier="public" /></TabItem>
            <TabItem Header="Projects"><local:ProjectView x:Name="ProjectScreen" DataContext="{Binding Projects}" x:FieldModifier="public" /></TabItem>
            <TabItem Header="Aufgaben"><local:TaskWorkView x:Name="TaskScreen" DataContext="{Binding Tasks}" x:FieldModifier="public" /></TabItem>
            <TabItem Header="Kategorien &amp; Anhänge"><local:CollaborationView x:Name="CollaborationScreen" DataContext="{Binding Collaboration}" x:FieldModifier="public" /></TabItem>
        </TabControl>
        <StatusBar Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource ContentForegroundBrush}">
            <TextBlock x:Name="ApplicationStatusLabel" x:FieldModifier="public" Text="{Binding Tenant.TenantName}" Style="{DynamicResource MainDataTextStyle}" />
        </StatusBar>
    </Grid>
</Window>
