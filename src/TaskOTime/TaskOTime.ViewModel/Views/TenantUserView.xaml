<?xml version="1.0" encoding="utf-8"?><UserControl x:Class="TaskOTime.ViewModel.Views.TenantUserView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{DynamicResource MainDataViewStyle}">
 <Grid Margin="11">
  <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <TextBlock x:Name="HeadingLabel" x:FieldModifier="public" Grid.ColumnSpan="3" Text="Mandanten und Benutzer" Style="{DynamicResource MainDataHeadingTextStyle}" />
  <ListView x:Name="TenantListView" ItemsSource="{Binding Tenants}" SelectedItem="{Binding SelectedTenant, Mode=TwoWay}" x:FieldModifier="public" Grid.Row="1" Width="260" HorizontalAlignment="Left" DisplayMemberPath="TenantName" Style="{DynamicResource MainDataListViewStyle}" />
  <Grid Grid.Row="1" Grid.Column="2" Margin="6,0,0,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="Mandant:" FontWeight="Bold" Margin="0,5,7,0" Style="{DynamicResource MainDataTextStyle}" />
    <TextBox x:Name="TenantNameTextBox" Text="{Binding TenantName, UpdateSourceTrigger=PropertyChanged}" x:FieldModifier="public" Width="260" Height="27" Style="{DynamicResource MainDataTextBoxStyle}" />
    <CheckBox x:Name="TenantActiveCheckBox" IsChecked="{Binding TenantActive}" x:FieldModifier="public" Content="aktiv" Margin="17,5" Style="{DynamicResource MainDataCheckBoxStyle}" />
   </StackPanel>
   <ListView x:Name="UserListView" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" x:FieldModifier="public" Grid.Row="1" Margin="0,12,0,9" Style="{DynamicResource MainDataListViewStyle}">
    <ListView.View><GridView ColumnHeaderContainerStyle="{DynamicResource MainDataGridViewColumnHeaderStyle}"><GridViewColumn Header="Benutzer" DisplayMemberBinding="{Binding UserIdent}" Width="190" /><GridViewColumn Header="E-Mail" DisplayMemberBinding="{Binding EMail}" Width="250" /><GridViewColumn Header="aktiv" DisplayMemberBinding="{Binding IsActive}" Width="65" /></GridView></ListView.View>
   </ListView>
   <StackPanel Grid.Row="2">
    <WrapPanel>
     <StackPanel><TextBlock Text="User name" Style="{DynamicResource MainDataTextStyle}" /><TextBox Width="150" Text="{Binding UserIdent, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MainDataTextBoxStyle}" /></StackPanel>
     <StackPanel><TextBlock Text="First name" Style="{DynamicResource MainDataTextStyle}" /><TextBox Width="120" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MainDataTextBoxStyle}" /></StackPanel>
     <StackPanel><TextBlock Text="Last name" Style="{DynamicResource MainDataTextStyle}" /><TextBox Width="120" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MainDataTextBoxStyle}" /></StackPanel>
     <StackPanel><TextBlock Text="Email" Style="{DynamicResource MainDataTextStyle}" /><TextBox Width="180" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource MainDataTextBoxStyle}" /></StackPanel>
     <StackPanel><TextBlock Text="Temporary password" Style="{DynamicResource MainDataTextStyle}" /><PasswordBox x:Name="TemporaryPasswordBox" Width="160" PasswordChanged="OnTemporaryPasswordChanged" Style="{DynamicResource MainDataPasswordBoxStyle}" /></StackPanel>
    </WrapPanel>
    <TextBlock Text="Tenant changes apply only to the current workspace." Style="{DynamicResource MainDataTextStyle}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="AddUserButton" Command="{Binding AddUserCommand}" x:FieldModifier="public" Content="Benutzer +" Width="112" Margin="3" Style="{DynamicResource MainDataButtonStyle}" />
    <Button x:Name="SaveTenantButton" Command="{Binding SaveTenantCommand}" x:FieldModifier="public" Content="Mandant speichern" Width="137" Margin="3" Style="{DynamicResource MainDataButtonStyle}" />
    <Button x:Name="DeleteUserButton" Command="{Binding DeleteUserCommand}" x:FieldModifier="public" Content="Benutzer löschen" Width="126" Margin="3" Style="{DynamicResource MainDataButtonStyle}" />
   </StackPanel>
   </StackPanel>
  </Grid>
 </Grid>
</UserControl>
