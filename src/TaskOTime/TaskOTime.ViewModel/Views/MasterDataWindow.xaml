<Window x:Class="Views.MasterDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskOTime.ViewModel.Views"
        Title="Task-o-Time Verwaltungsarbeitsplatz" Height="760" Width="1180"
        Background="#FFE7E9EC" FontFamily="Segoe UI">
    <Grid Margin="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="31"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="MidnightBlue" CornerRadius="3" Padding="13,5">
            <DockPanel>
                <TextBlock x:Name="TitleLabel" x:FieldModifier="public" Text="Task-o-Time" Foreground="White"
                           FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="AboutButton" x:FieldModifier="public" Content="Info" Width="82" Height="27"
                        DockPanel.Dock="Right" HorizontalAlignment="Right" Background="LightSteelBlue"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="WorkspaceTabs" x:FieldModifier="public" Grid.Row="1" Margin="0,9,0,4" Background="WhiteSmoke">
            <TabItem Header="Mandanten / Benutzer"><local:TenantUserView x:Name="TenantUserScreen" x:FieldModifier="public"/></TabItem>
            <TabItem Header="Projekte"><local:ProjectView x:Name="ProjectScreen" x:FieldModifier="public"/></TabItem>
            <TabItem Header="Aufgaben"><local:TaskWorkView x:Name="TaskScreen" x:FieldModifier="public"/></TabItem>
            <TabItem Header="Kategorien &amp; Anhänge"><local:CollaborationView x:Name="CollaborationScreen" x:FieldModifier="public"/></TabItem>
        </TabControl>
        <StatusBar Grid.Row="2" Background="#FFD9E3F0">
            <TextBlock x:Name="ApplicationStatusLabel" x:FieldModifier="public" Text="Bereit." Foreground="DarkSlateBlue"/>
        </StatusBar>
    </Grid>
</Window>
