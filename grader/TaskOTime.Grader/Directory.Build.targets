<Project>
  <Target Name="WriteEvaluatorConfiguration" AfterTargets="Build">
    <WriteLinesToFile File="$(TargetDir)evaluator-sdk.txt"
                      Lines="$(MSBuildSDKsPath)" Overwrite="true" />
    <WriteLinesToFile File="$(TargetDir)evaluator-configuration.txt"
                      Lines="$(Configuration)" Overwrite="true" />
    <Error Condition="$([System.String]::Copy('$(NETCoreSdkVersion)').StartsWith('10.')) != 'true'"
           Text="Build TaskOTime.Grader with the .NET 10 SDK." />
  </Target>
</Project>
